# Copiar a .env para sobrescribir los valores por defecto del docker-compose.yml
DB_USER=nexo
DB_PASSWORD=nexo
INTERNAL_API_KEY=dev-internal-key-change-me

# Claves RSA de ms-auth en PEM PKCS#8 (opcional). Si se omiten, ms-auth genera claves efímeras al arrancar
# y los tokens emitidos dejan de ser válidos tras cada reinicio. Para generarlas:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out signing.pem
# JWT_SIGNING_KEY="-----BEGIN PRIVATE KEY-----..."
# JWT_ENCRYPTION_KEY="-----BEGIN PRIVATE KEY-----..."

# Clave AES-256 (Base64) con la que ms-customer cifra cédula y teléfono en reposo. Si se omite, el compose usa una
# clave fija de desarrollo. ¡Cambiarla con datos ya cifrados los vuelve ilegibles! Para generarla:
#   openssl rand -base64 32
# CUSTOMER_DATA_KEY=

# Túnel HTTPS (perfil `tunnel`): URL pública y fija del gateway para probar la app en cualquier teléfono y red.
#   1. Crear cuenta gratuita en https://dashboard.ngrok.com y copiar el authtoken.
#   2. En "Domains", reclamar el dominio estático gratuito (p. ej. nexo-demo.ngrok-free.app).
#   3. docker compose --profile tunnel up -d
#   4. En la app: poner https://<dominio> en config/staging.json (una sola vez, se versiona para todo el equipo).
# NGROK_AUTHTOKEN=
# NGROK_DOMAIN=nexo-demo.ngrok-free.app

# Notificaciones push reales con Firebase Cloud Messaging (opcional). Sin esto, ms-customer registra las push en el log.
#   1. Firebase Console → Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada.
#   2. Guardar el JSON como ./secrets/firebase-adminsdk.json (la carpeta está en .gitignore).
#   3. docker compose up -d ms-customer
# FCM_CREDENTIALS_FILE=/run/secrets/nexo/firebase-adminsdk.json
