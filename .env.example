# Copiar a .env para sobrescribir los valores por defecto del docker-compose.yml
DB_USER=nexo
DB_PASSWORD=nexo
INTERNAL_API_KEY=dev-internal-key-change-me

# Claves RSA de ms-auth en PEM PKCS#8 (opcional). Si se omiten, ms-auth genera claves efímeras al arrancar
# y los tokens emitidos dejan de ser válidos tras cada reinicio. Para generarlas:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out signing.pem
# JWT_SIGNING_KEY="-----BEGIN PRIVATE KEY-----..."
# JWT_ENCRYPTION_KEY="-----BEGIN PRIVATE KEY-----..."

# Clave AES-256 (Base64) con la que ms-customer cifra cédula y teléfono en reposo. Si se omite, el compose usa una
# clave fija de desarrollo. ¡Cambiarla con datos ya cifrados los vuelve ilegibles! Para generarla:
#   openssl rand -base64 32
# CUSTOMER_DATA_KEY=
